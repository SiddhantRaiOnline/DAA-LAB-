#include <stdio.h>

int main()
{
    int a[10][10], n;
    int i, j, celebrity = -1;
    int knownByEveryone, knowsNobody;

    printf("Enter number of people: ");
    scanf("%d", &n);

    printf("Enter the matrix:\n");

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    for(i = 0; i < n; i++)
    {
        knownByEveryone = 1;
        knowsNobody = 1;

        for(j = 0; j < n; j++)
        {
            if(a[i][j] == 1)
                knowsNobody = 0;

            if(i != j && a[j][i] == 0)
                knownByEveryone = 0;
        }

        if(knownByEveryone == 1 && knowsNobody == 1)
        {
            celebrity = i;
            break;
        }
    }

    if(celebrity == -1)
        printf("No celebrity found");
    else
        printf("Celebrity is person %d", celebrity);

    return 0;
}
